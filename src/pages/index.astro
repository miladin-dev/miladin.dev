---
import Container from "../layouts/Container.astro";
import { Icon } from "astro-icon/components";
import Link from "../layouts/Link.astro";
---

<Container title="miladin.dev">
	<main class="divide-y divide-dashed text-base">
		<section
			class="hover:underline hover:decoration-dashed hover:decoration-starla-light hover:decoration-1 underline-offset-2"
		>
			<p>
				I’m a software engineer at Google with interests in cloud,
				networking, infrastructure, and distributed systems.
			</p>
			<p>In my free time, I enjoy reading research papers on AI/ML.</p>
		</section>
		<section
			class="hover:underline hover:decoration-dashed hover:decoration-starla-light hover:decoration-1 underline-offset-2"
		>
			<p>
				Before joining Google, I've spent 3 years at startup - <Link
					href="https://strong.network"
					><span
						class="underline underline-offset-2 hover:decoration-starla-accent hover:decoration-2"
						>strong.network</span
					></Link
				>.
				<p>
					I was part of the initial engineering team where we worked
					on creating a self-hosted platform that allows organizations
					to create secure linux cloud dev environments. Worked a lot
					with containers, their security and internals, networking,
					infrastructure and real-time distributed systems.
				</p>
				<br />
				<p>
					Our team got <Link
						href="https://www.citrix.com/blogs/2024/12/10/citrix-acquires-devicetrust-and-strong-network/"
					>
						<span
							class="underline underline-offset-2 hover:decoration-starla-accent hover:decoration-2"
							>acquired by Citrix, (Cloud Software Group)</span
						></Link
					> in November 2024.
				</p>
			</p>
		</section>
		<section
			class="flex sm:gap-24 gap-16 !pt-[50px] justify-center text-starla-black"
		>
			<Link href="https://github.com/miladin-dev">
				<Icon
					name="links/github"
					title="GitHub"
					size="25"
					class="text-starla-dblue hover:text-starla-blue drop-shadow-md"
				/>
			</Link>
			<Link href="https://www.linkedin.com/in/miladindev/">
				<Icon
					name="links/linkedin"
					title="LinkedIn"
					size="25"
					class="text-starla-dblue hover:text-starla-blue drop-shadow-md"
				/>
			</Link>
			<Link href="mailto:miladindev@gmail.com">
				<Icon
					name="links/envelope-fill"
					title="Email"
					size="25"
					class="text-starla-dblue hover:text-starla-blue drop-shadow-md"
				/>
			</Link>
			<Link href="https://x.com/miladindev">
				<Icon
					name="links/x"
					title="X/Twitter"
					size="25"
					class="text-starla-dblue hover:text-starla-blue drop-shadow-md"
				/>
			</Link>
		</section>
	</main>
</Container>

<style lang="scss">
	ul {
		padding-left: 1rem;
		li {
			list-style-type: circle;
			margin-bottom: 0.3rem;
			&:first-child {
				margin-top: 0.3rem;
			}
			&:last-child {
				margin-bottom: 0;
			}
		}
	}
	main > section {
		padding: 1.5rem 0;
	}
</style>
